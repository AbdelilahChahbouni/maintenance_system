<LoginScreen>:
    name: "login"

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.95, 0.96, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.85, 0.7
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: 20
            padding: 25
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [25]

            Image:
                source: "assets/logo.png"
                size_hint_y: None
                height: 100
                allow_stretch: True
                keep_ratio: True

            Label:
                text: "Welcome Back"
                font_size: 28
                bold: True
                color: 0.2, 0.2, 0.3, 1

            TextInput:
                id: email
                hint_text: "Email"
                multiline: False
                size_hint_y: None
                height: 50
                background_normal: ""
                background_color: (0.95, 0.95, 0.95, 1)
                padding: [15, 15]
                on_text: root.email = self.text

            TextInput:
                id: password
                hint_text: "Password"
                password: True
                multiline: False
                size_hint_y: None
                height: 50
                background_normal: ""
                background_color: (0.95, 0.95, 0.95, 1)
                padding: [15, 15]
                on_text: root.password = self.text

            Label:
                id: login_msg
                text: ""
                color: 1, 0, 0, 1

            Button:
                text: "Login"
                size_hint_y: None
                height: 50
                font_size: 20
                background_normal: ""
                background_color: (0.2, 0.6, 0.9, 1)
                color: 1, 1, 1, 1
                bold: True
                on_press: root.do_login()
                canvas.before:
                    Color:
                        rgba: (0.2, 0.6, 0.9, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [25]
