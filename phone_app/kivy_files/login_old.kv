<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Login"
            font_size: 36
            bold: True
            color: 0.2, 0.2, 0.2, 1
            size_hint_y: None
            height: 60

        TextInput:
            id: email
            hint_text: "Email"
            font_size: 20
            multiline: False
            on_text: root.email = self.text

        TextInput:
            id: password
            hint_text: "Password"
            password: True
            font_size: 20
            multiline: False
            on_text: root.password = self.text

        Label:
            id: login_msg
            text: ""
            color: 1,0,0,1
            size_hint_y: None
            height: 30

        Button:
            text: "Login"
            size_hint_y: None
            height: 50
            font_size: 22
            background_color: 0.1, 0.5, 0.8, 1
            color: 1,1,1,1
            on_press: root.do_login()
